# Copy to .env and fill in. .env is gitignored.

# Generation
ANTHROPIC_API_KEY=sk-ant-...

# Adapter credentials
# GitHub: a fine-grained PAT with public repo read + gist write is enough.
GITHUB_TOKEN=github_pat_...

# Stripe: TEST MODE ONLY. The adapter refuses to run on a live key.
STRIPE_SECRET_KEY=sk_test_...

# Optional: where to cache downloaded OpenAPI specs
# HARNESS_CACHE_DIR=.cache
